# 复制到仓库根目录 .env，填写后重启后端。
# .env 已由 .gitignore 排除。不要把真实密钥写入本模板或 VITE_ 变量。
# 也可由部署环境注入；已有进程环境变量优先于 .env。

# 模型服务 API Key（必填）。未配置时仅禁用 AI 分解，规则分解继续可用。
LLM_API_KEY=

# Chat Completions 兼容 API 根地址（必填），保留服务商要求的版本路径。
# 程序会追加 /chat/completions；不要填写完整的该请求路径。
# 远程地址要求 HTTPS，本机回环地址可以使用 HTTP。
# 不允许在 URL 中填写用户名、密码、查询参数或片段。
LLM_BASE_URL=

# 服务商提供的确切模型名称（必填），不在代码中硬编码。
LLM_MODEL=
