{
  "name": "visual-task-orchestrator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspace frontend",
    "check": "npm test && npm run build",
    "test:e2e": "npm run build && playwright test",
    "package:web": "npm run build && node scripts/package-web.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "vitest": "~1.6.1",
    "@playwright/test": "^1.51.0"
  }
}
