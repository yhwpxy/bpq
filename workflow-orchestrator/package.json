{
  "name": "workflow-orchestrator",
  "version": "0.2.0",
  "private": true,
  "description": "Requirements-to-Execution Real-Time Workflow Orchestration Subsystem",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package:release": "node scripts/package-release.mjs",
    "start": "node --env-file-if-exists=../.env scripts/start.mjs",
    "start:web": "node --env-file-if-exists=../.env scripts/serve-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "gts lint",
    "format": "gts fix",
    "verify:gates": "node scripts/run-verify.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "esbuild": "^0.27.0",
    "gts": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
